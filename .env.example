# ============================================================
#  Your IPTV subscription
# ============================================================
# Xtream Codes: base is scheme + host + port ONLY (no path/slash).
XTREAM_BASE=http://your-provider.example:8080
XTREAM_USERNAME=your_username
XTREAM_PASSWORD=your_password

# Plain M3U instead. Used only when XTREAM_BASE is empty.
M3U_URL=

# ============================================================
#  The connection limit - the important one
# ============================================================
# How many streams your PROVIDER allows at once. This is NOT the number of
# friends who can watch. One upstream connection is fanned out to unlimited
# viewers; this only sets how many DIFFERENT channels can run at a time.
#
# With 1 (the usual case) everyone shares a single channel: a TV room.
# Run `npm run check` to see what your plan actually allows.
UPSTREAM_CONNECTIONS=1

# Who may change the shared channel:
#   anyone - any viewer can change it
#   roles  - the highest-ranked person IN THE ROOM holds the remote (Boss,
#            then 2nd, then 3rd...). Turns on automatically if any access
#            code below has a rank; leave this blank to auto-detect.
CHANNEL_CONTROL=

# After any channel change, block further changes for this many seconds
# (stops the remote being spammed or fought over). 0 disables it.
CHANGE_COOLDOWN_SECONDS=30

# ============================================================
#  Access control
# ============================================================
# One code per friend: name:code:rank  (comma separated, individually
# revocable). Rank 1 = Boss, 2 = next in line, 3 = after that... Whoever
# has the LOWEST rank number currently in the room holds the remote; when
# they leave, it passes to the next. Omit the rank for a plain viewer who
# can only watch (they get the lowest priority).
#   e.g. ACCESS_CODES=you:bosscode:1,alex:alexcode:2,rafi:raficode:3,guest:guestcode
ACCESS_CODES=you:change-me-now:1,alex:pick-something-random:2

# Long random string. MUST be set and kept stable in production, or every
# restart signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# Set to 1 when served over HTTPS (any real deployment).
COOKIE_SECURE=0

# ============================================================
#  Tuning (defaults are fine)
# ============================================================
# Segments held in memory per channel. More = smoother for slow viewers,
# more RAM and slightly more delay behind live.
SEGMENT_WINDOW=8

# Stop pulling from the provider this long after the last viewer leaves,
# which frees your single connection for your own TV.
IDLE_STOP_SECONDS=40

PORT=3000
